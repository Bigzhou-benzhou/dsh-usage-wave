{
  "name": "dsh-usage-wave",
  "version": "0.2.0",
  "description": "Balance + remaining tokens + token/money consumption waveform for DeepSeek Harness: a sidebar footer card and a docked left panel with 1h/6h/24h/7d ranges, live tok/s strip and per-command cost breakdown.",
  "license": "MIT",
  "author": "dsh-usage-wave contributors",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "usage",
    "tokens",
    "balance",
    "dashboard",
    "client-plugin"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  }
}
